DATABASE_URL="file:./dev.db"

# Backup (npm run backup) — compacta dev.db + storage/anexos em um .zip.
# BACKUP_LOCAL_DIR: pasta local para guardar os backups (padrão: ./backups).
# BACKUP_ONEDRIVE_DIR: opcional — pasta sincronizada pelo app do OneDrive no
# seu computador (ex.: no Mac algo como
# "/Users/seu-usuario/Library/CloudStorage/OneDrive-Personal/Backups/PastanaMota").
# Uma cópia do backup é gravada ali e o próprio OneDrive envia para a nuvem.
# BACKUP_RETENCAO_DIAS: quantos dias manter backups antigos antes de apagar (padrão: 30).
# BACKUP_LOCAL_DIR="./backups"
# BACKUP_ONEDRIVE_DIR="/Users/seu-usuario/Library/CloudStorage/OneDrive-Personal/Backups/PastanaMota"
# BACKUP_RETENCAO_DIAS=30

# Notificações de prazo por WhatsApp — segredo exigido pela rota
# /api/notificacoes/verificar, chamada periodicamente pelo agendador do
# sistema (veja scripts/com.pastanamota.notificacoes.plist.example).
# Gere um valor aleatório qualquer (ex.: openssl rand -hex 32) e use o mesmo
# valor no cabeçalho Authorization configurado no agendador.
# NOTIFICACOES_CRON_SECRET="troque-por-um-valor-aleatorio"

# Busca automática de publicações no DJEN — segredo exigido pela rota
# /api/publicacoes-djen/verificar, chamada periodicamente pelo agendador do
# sistema (veja scripts/com.pastanamota.publicacoes.plist.example).
# Gere um valor aleatório qualquer (ex.: openssl rand -hex 32) e use o mesmo
# valor no cabeçalho Authorization configurado no agendador.
# PUBLICACOES_CRON_SECRET="troque-por-um-valor-aleatorio"

# Atualizações ao cliente (Processo → "Atualizar cliente")
# ANTHROPIC_API_KEY: chave da API da Anthropic, usada pela IA que lê o PDF do
# processo e redige a mensagem. Crie em https://platform.claude.com (API Keys).
# ANTHROPIC_API_KEY="sk-ant-..."
#
# GMAIL_USUARIO / GMAIL_SENHA_APP: conta Gmail que envia os e-mails aos
# clientes. A senha NÃO é a senha normal do Gmail: é uma "senha de app"
# (ative a verificação em duas etapas e gere em
# https://myaccount.google.com/apppasswords).
# GMAIL_USUARIO="pastana.adv@gmail.com"
# GMAIL_SENHA_APP="abcd efgh ijkl mnop"
