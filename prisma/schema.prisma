generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum TipoCliente {
  PF
  PJ
}

enum AreaProcesso {
  CIVEL
  PREVIDENCIARIO
  TRIBUTARIO
  OUTRO
}

