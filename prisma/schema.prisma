generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum TipoCliente {
  PF
  PJ
}

enum AreaProcesso {
  CIVEL
  PREVIDENCIARIO
  TRIBUTARIO
  OUTRO
}

enum StatusProcesso {
  ATIVO
  SUSPENSO
  ARQUIVADO
  ENCERRADO
}

enum TipoPrazo {
  PETICAO
  RECURSO
  AUDIENCIA
  MANIFESTACAO
  OUTRO
}

enum TipoContagem {
  DIAS_UTEIS
  DIAS_CORRIDOS
}

enum StatusPrazo {
  PENDENTE
  CUMPRIDO
  PERDIDO
}

enum TipoHonorario {
  FIXO
  PARCELADO
  EXITO
  MENSALIDADE
}

enum StatusParcela {
  PENDENTE
  PAGO
  ATRASADO
}

enum StatusSucumbencia {
  AGUARDANDO_DECISAO
  DEFINIDO
  EM_EXECUCAO
  RECEBIDO
}

enum FormaRecebimento {
  RPV
  PRECATORIO
  DEPOSITO_DIRETO
  OUTRO
}

enum StatusAlvara {
  AGUARDANDO_REPASSE
  REPASSADO
}

enum CategoriaDespesa {
  CUSTAS
  ALUGUEL
  MATERIAL
  OUTRO
}

enum TipoObrigacaoSocietaria {
  PRO_LABORE
  DAS
  INSS_SOCIO
  CPP_PATRONAL
}

enum StatusObrigacao {
  PAGO
  PENDENTE
}

model Cliente {
  id           String      @id @default(cuid())
  nome         String
  tipo         TipoCliente
  cpfCnpj      String?
  telefone     String?
  email        String?
  observacoes  String?
  criadoEm     DateTime    @default(now())
  processos    Processo[]
}

model Processo {
  id              String         @id @default(cuid())
  clienteId       String
  cliente         Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  numeroProcesso  String?
  area            AreaProcesso
  vara            String?
  comarca         String?
  status          StatusProcesso @default(ATIVO)
  resumo          String?
  criadoEm        DateTime       @default(now())
  prazos          Prazo[]
  honorarios              Honorario[]
  honorariosSucumbenciais HonorarioSucumbencial[]
  alvaras                 Alvara[]
  despesas                Despesa[]
}

model Prazo {
  id           String       @id @default(cuid())
  processoId   String
  processo     Processo     @relation(fields: [processoId], references: [id], onDelete: Cascade)
  tipo         TipoPrazo
  dataBase     DateTime?
  dias         Int?
  contagem     TipoContagem?
  dataFinal    DateTime
  status       StatusPrazo  @default(PENDENTE)
  observacoes  String?
  criadoEm     DateTime     @default(now())
}

model Honorario {
  id               String        @id @default(cuid())
  processoId       String
  processo         Processo      @relation(fields: [processoId], references: [id], onDelete: Cascade)
  tipo             TipoHonorario
  valorTotal       Float?
  percentualExito  Float?
  dataContrato     DateTime
  observacoes      String?
  criadoEm         DateTime      @default(now())
  parcelas         Parcela[]
}

model Parcela {
  id                 String        @id @default(cuid())
  honorarioId         String
  honorario           Honorario     @relation(fields: [honorarioId], references: [id], onDelete: Cascade)
  numero              Int
  valor               Float
  vencimento          DateTime
  status              StatusParcela @default(PENDENTE)
  dataPagamento       DateTime?
  notaFiscalEmitida   Boolean       @default(false)
  dataEmissaoNf       DateTime?
  criadoEm            DateTime      @default(now())
}

model HonorarioSucumbencial {
  id                    String            @id @default(cuid())
  processoId            String
  processo              Processo          @relation(fields: [processoId], references: [id], onDelete: Cascade)
  valorEstimado         Float?
  valorDefinido         Float?
  percentual            Float?
  status                StatusSucumbencia @default(AGUARDANDO_DECISAO)
  formaRecebimento      FormaRecebimento?
  dataTransitoJulgado   DateTime?
  dataRecebimento       DateTime?
  notaFiscalEmitida     Boolean           @default(false)
  dataEmissaoNf         DateTime?
  observacoes           String?
  criadoEm              DateTime          @default(now())
  alvaras               Alvara[]
}

model Alvara {
  id                       String                 @id @default(cuid())
  processoId               String
  processo                 Processo               @relation(fields: [processoId], references: [id], onDelete: Cascade)
  honorarioSucumbencialId  String?
  honorarioSucumbencial    HonorarioSucumbencial? @relation(fields: [honorarioSucumbencialId], references: [id], onDelete: SetNull)
  valorTotal               Float
  valorRetido              Float
  valorRepassado           Float
  dataRecebimento          DateTime?
  dataRepasse              DateTime?
  status                   StatusAlvara           @default(AGUARDANDO_REPASSE)
  bancoDestino             String?
  agenciaDestino           String?
  contaDestino             String?
  chavePixDestino          String?
  observacoes              String?
  criadoEm                 DateTime               @default(now())
}

model Despesa {
  id          String           @id @default(cuid())
  descricao   String
  categoria   CategoriaDespesa
  valor       Float
  data        DateTime
  processoId  String?
  processo    Processo?        @relation(fields: [processoId], references: [id], onDelete: SetNull)
  criadoEm    DateTime         @default(now())
}

model ObrigacaoSocietaria {
  id             String                  @id @default(cuid())
  competencia    DateTime
  tipo           TipoObrigacaoSocietaria
  valor          Float
  dataPagamento  DateTime?
  status         StatusObrigacao         @default(PENDENTE)
  observacoes    String?
  criadoEm       DateTime                @default(now())

  @@unique([competencia, tipo])
}

model RetiradaLucro {
  id           String    @id @default(cuid())
  data         DateTime
  valor        Float
  observacoes  String?
  criadoEm     DateTime  @default(now())
}
