generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum TipoCliente {
  PF
  PJ
}

enum AreaProcesso {
  CIVEL
  PREVIDENCIARIO
  TRIBUTARIO
  OUTRO
}

enum StatusProcesso {
  ATIVO
  SUSPENSO
  ARQUIVADO
  ENCERRADO
}

enum TipoPrazo {
  PETICAO
  RECURSO
  AUDIENCIA
  MANIFESTACAO
  OUTRO
}

enum TipoContagem {
  DIAS_UTEIS
  DIAS_CORRIDOS
}

enum StatusPrazo {
  PENDENTE
  CUMPRIDO
  PERDIDO
}

model Cliente {
  id           String      @id @default(cuid())
  nome         String
  tipo         TipoCliente
  cpfCnpj      String?
  telefone     String?
  email        String?
  observacoes  String?
  criadoEm     DateTime    @default(now())
  processos    Processo[]
}

model Processo {
  id              String         @id @default(cuid())
  clienteId       String
  cliente         Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  numeroProcesso  String?
  area            AreaProcesso
  varaTribunal    String?
  status          StatusProcesso @default(ATIVO)
  resumo          String?
  criadoEm        DateTime       @default(now())
  prazos          Prazo[]
}

model Prazo {
  id           String       @id @default(cuid())
  processoId   String
  processo     Processo     @relation(fields: [processoId], references: [id], onDelete: Cascade)
  tipo         TipoPrazo
  dataBase     DateTime
  dias         Int
  contagem     TipoContagem
  dataFinal    DateTime
  status       StatusPrazo  @default(PENDENTE)
  observacoes  String?
  criadoEm     DateTime     @default(now())
}
