model Cliente {
  id           String      @id @default(cuid())
  nome         String
  tipo         TipoCliente
  cpfCnpj      String?
  telefone     String?
  email        String?
  observacoes  String?
  criadoEm     DateTime    @default(now())
  processos    Processo[]
  processosAdministrativos ProcessoAdministrativo[]
}

model Processo {
  id              String         @id @default(cuid())
  clienteId       String
  cliente         Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  numeroProcesso  String?
  area            AreaProcesso
  areaOutraDescricao String?
  jurisdicao      Jurisdicao?
  rito            Rito?
  tribunal        Tribunal?
  vara            String?
  comarca         String?
  status          StatusProcesso @default(ATIVO)
  resumo          String?
  criadoEm        DateTime       @default(now())
  prazos          Prazo[]
  andamentos              Andamento[]
  recursos                Recurso[]
  honorarios              Honorario[]
  honorariosSucumbenciais HonorarioSucumbencial[]
  alvaras                 Alvara[]
  despesas                Despesa[]
  processosAdministrativosVinculados ProcessoAdministrativo[]
  publicacoes             Publicacao[]
}

model Prazo {
  id           String       @id @default(cuid())
  processoId   String
  processo     Processo     @relation(fields: [processoId], references: [id], onDelete: Cascade)
  tipo         TipoPrazo
  dataBase     DateTime?
  dias         Int?
  contagem     TipoContagem?
  dataFinal    DateTime
  status       StatusPrazo  @default(PENDENTE)
  modalidadeAudiencia  ModalidadeAudiencia?
  linkAudiencia        String?
  contatoVaraAudiencia String?
  origemAndamentoId    String?
  origemAndamento      Andamento?   @relation(fields: [origemAndamentoId], references: [id], onDelete: SetNull)
  /// Sobrescreve, só para este prazo, os dias de antecedência do alerta de WhatsApp.
  /// Quando nulo, usa ConfiguracaoNotificacao.antecedenciaPadraoDias.
  diasAntecedenciaNotificacao Int?
  observacoes  String?
  criadoEm     DateTime     @default(now())
  notificacoes Notificacao[]
  redesignacoes Redesignacao[]
}

/// Histórico de redesignações de audiência de um Prazo (tipo AUDIENCIA).
model Redesignacao {
  id           String   @id @default(cuid())
  prazoId      String
  prazo        Prazo    @relation(fields: [prazoId], references: [id], onDelete: Cascade)
  dataAnterior DateTime
  dataNova     DateTime
  motivo       String
  dataRegistro DateTime @default(now())
}

/// Log de envios de alerta de prazo via WhatsApp (Evolution API ou Z-API).
model Notificacao {
  id               String            @id @default(cuid())
  prazoId          String
  prazo            Prazo             @relation(fields: [prazoId], references: [id], onDelete: Cascade)
  dataEnvio        DateTime          @default(now())
  status           StatusNotificacao
  mensagemEnviada  String
}

/// Configuração única (linha id=1) da rotina de notificação de prazos por WhatsApp.
model ConfiguracaoNotificacao {
  id                     Int                  @id @default(1)
  numeroWhatsapp         String?
  antecedenciaPadraoDias Int                  @default(3)
  /// Horário de disparo da rotina diária, formato "HH:MM" (hora local do computador que roda o app).
  horarioDisparo         String               @default("08:00")
  provedor               ProvedorNotificacao?
  /// URL do servidor Evolution API self-hosted (não usada pela Z-API, que tem endpoint fixo).
  urlBaseApi             String?
  /// Nome da instância (Evolution API) ou ID da instância (Z-API).
  instanciaId            String?
  /// apikey (Evolution API) ou token (Z-API).
  credencialApi          String?
  atualizadoEm           DateTime             @updatedAt
}

enum StatusVinculoPublicacao {
  VINCULADA
  ORFA
}

/// Publicação importada do Diário de Justiça Eletrônico Nacional (DJEN), via
/// consulta pública à API comunicaapi.pje.jus.br filtrada por OAB/seccional.
/// Vinculada a um Processo quando o número extraído do texto bate com um
/// numeroProcesso já cadastrado; senão fica "órfã" até vinculação manual.
model Publicacao {
  id                         String                  @id @default(cuid())
  numeroProcessoIdentificado String?
  processoId                 String?
  processo                   Processo?               @relation(fields: [processoId], references: [id], onDelete: SetNull)
  dataPublicacao              DateTime
  tribunalOrgao               String
  textoPublicacao              String
  statusVinculo                StatusVinculoPublicacao @default(ORFA)
  lida                          Boolean                 @default(false)
  /// id retornado pela API do DJEN para esta comunicação — evita reimportar a
  /// mesma publicação em execuções repetidas da rotina diária.
  idExternoDjen                 String                  @unique
  criadoEm                     DateTime                @default(now())
}

/// Configuração única (linha id=1) da rotina diária de busca de publicações no DJEN.
model ConfiguracaoPublicacoes {
  id              Int       @id @default(1)
  numeroOab       String?
  seccionalOab    String?
  /// Horário de disparo da rotina diária, formato "HH:MM" (hora local do computador que roda o app).
  horarioConsulta String    @default("07:00")
  /// Data (dia) da última execução bem-sucedida — evita rodar a rotina mais de uma vez no mesmo dia.
  ultimaExecucao  DateTime?
  atualizadoEm    DateTime  @updatedAt
}

/// Log manual de andamentos, compartilhado entre Processo (judicial) e
/// ProcessoAdministrativo — vincula-se a exatamente um dos dois (nunca os
/// dois, regra aplicada em lib/actions/andamentos.ts, não no schema). Mesma
/// lógica para o vínculo com Recurso/RecursoAdministrativo. Anexo opcional e
/// atalho para gerar um Prazo vinculado (só no contexto judicial).
model Andamento {
  id              String        @id @default(cuid())
  processoId      String?
  processo        Processo?     @relation(fields: [processoId], references: [id], onDelete: Cascade)
  processoAdministrativoId String?
  processoAdministrativo   ProcessoAdministrativo? @relation(fields: [processoAdministrativoId], references: [id], onDelete: Cascade)
  data            DateTime
  tipo            TipoAndamento
  descricao       String
  arquivoNome     String?
  arquivoCaminho  String?
  arquivoTipo     String?
  recursoId       String?
  recurso         Recurso?      @relation(fields: [recursoId], references: [id], onDelete: SetNull)
  recursoAdministrativoId String?
  recursoAdministrativo   RecursoAdministrativo? @relation(fields: [recursoAdministrativoId], references: [id], onDelete: SetNull)
  criadoEm        DateTime      @default(now())
  prazosGerados   Prazo[]
}

/// Recurso de 2º grau vinculado ao Processo. Status e resultado são
/// atualizados automaticamente a partir de Andamentos do tipo "remessa ao 2º
/// grau" e "julgamento de recurso" vinculados a este registro (ver
/// lib/actions/andamentos.ts).
model Recurso {
  id               String            @id @default(cuid())
  processoId       String
  processo         Processo          @relation(fields: [processoId], references: [id], onDelete: Cascade)
  tipoRecurso      TipoRecurso
  dataInterposicao DateTime
  tribunal2Grau    Tribunal?
  orgaoJulgador    String?
  relator          String?
  status           StatusRecurso     @default(AGUARDANDO_REMESSA)
  resultado        ResultadoRecurso?
  dataJulgamento   DateTime?
  observacoes      String?
  criadoEm         DateTime          @default(now())
  andamentos       Andamento[]
}

/// Processo administrativo junto a INSS ou Receita Federal — entidade
/// independente de Processo (judicial), com vínculo opcional a um Processo
/// quando o caso evolui para ação judicial.
model ProcessoAdministrativo {
  id                 String                       @id @default(cuid())
  clienteId          String
  cliente            Cliente                      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  processoJudicialId String?
  processoJudicial   Processo?                    @relation(fields: [processoJudicialId], references: [id], onDelete: SetNull)
  orgao              OrgaoProcessoAdministrativo
  tipo               TipoProcessoAdministrativo
  numeroProtocolo    String?
  status             StatusProcessoAdministrativo @default(EM_ANALISE)
  dataAbertura       DateTime
  dataDecisao        DateTime?
  resumo             String?
  observacoes        String?
  criadoEm           DateTime                     @default(now())
  andamentos         Andamento[]
  recursos           RecursoAdministrativo[]
}

/// Recurso administrativo (CRPS/CARF) vinculado a um ProcessoAdministrativo.
/// Status e resultado são atualizados automaticamente a partir de Andamentos
/// de remessa/julgamento vinculados a este registro, mesma lógica do Recurso
/// judicial (ver lib/actions/andamentos.ts).
model RecursoAdministrativo {
  id                       String                          @id @default(cuid())
  processoAdministrativoId String
  processoAdministrativo   ProcessoAdministrativo          @relation(fields: [processoAdministrativoId], references: [id], onDelete: Cascade)
  orgaoRecursal            OrgaoRecursal
  dataInterposicao         DateTime
  status                   StatusRecursoAdministrativo     @default(AGUARDANDO_ANALISE)
  resultado                ResultadoRecursoAdministrativo?
  dataJulgamento           DateTime?
  observacoes              String?
  criadoEm                 DateTime                        @default(now())
  andamentos               Andamento[]
}

model Honorario {
  id               String        @id @default(cuid())
  processoId       String
  processo         Processo      @relation(fields: [processoId], references: [id], onDelete: Cascade)
  tipo             TipoHonorario
  valorTotal       Float?
  percentualExito  Float?
  dataContrato     DateTime
  observacoes      String?
  criadoEm         DateTime      @default(now())
  parcelas         Parcela[]
}

model Parcela {
  id                 String        @id @default(cuid())
  honorarioId         String
  honorario           Honorario     @relation(fields: [honorarioId], references: [id], onDelete: Cascade)
  numero              Int
  valor               Float
  vencimento          DateTime
  status              StatusParcela @default(PENDENTE)
  dataPagamento       DateTime?
  notaFiscalEmitida   Boolean       @default(false)
  dataEmissaoNf       DateTime?
  criadoEm            DateTime      @default(now())
}

model HonorarioSucumbencial {
  id                    String            @id @default(cuid())
  processoId            String
  processo              Processo          @relation(fields: [processoId], references: [id], onDelete: Cascade)
  valorEstimado         Float?
  valorDefinido         Float?
  percentual            Float?
  status                StatusSucumbencia @default(AGUARDANDO_DECISAO)
  formaRecebimento      FormaRecebimento?
  dataTransitoJulgado   DateTime?
  dataRecebimento       DateTime?
  notaFiscalEmitida     Boolean           @default(false)
  dataEmissaoNf         DateTime?
  observacoes           String?
  criadoEm              DateTime          @default(now())
  alvaras               Alvara[]
}

model Alvara {
  id                       String                 @id @default(cuid())
  processoId               String
  processo                 Processo               @relation(fields: [processoId], references: [id], onDelete: Cascade)
  honorarioSucumbencialId  String?
  honorarioSucumbencial    HonorarioSucumbencial? @relation(fields: [honorarioSucumbencialId], references: [id], onDelete: SetNull)
  valorTotal               Float
  valorRetido              Float
  valorRepassado           Float
  dataRecebimento          DateTime?
  dataRepasse              DateTime?
  status                   StatusAlvara           @default(AGUARDANDO_REPASSE)
  bancoDestino             String?
  agenciaDestino           String?
  contaDestino             String?
  chavePixDestino          String?
  observacoes              String?
  criadoEm                 DateTime               @default(now())
}

model Despesa {
  id          String           @id @default(cuid())
  descricao   String
  categoria   CategoriaDespesa
  valor       Float
  data        DateTime
  processoId  String?
  processo    Processo?        @relation(fields: [processoId], references: [id], onDelete: SetNull)
  criadoEm    DateTime         @default(now())
}

model ObrigacaoSocietaria {
  id             String                  @id @default(cuid())
  competencia    DateTime
  tipo           TipoObrigacaoSocietaria
  valor          Float
  dataPagamento  DateTime?
  status         StatusObrigacao         @default(PENDENTE)
  observacoes    String?
  criadoEm       DateTime                @default(now())

  @@unique([competencia, tipo])
}

model RetiradaLucro {
  id           String    @id @default(cuid())
  data         DateTime
  valor        Float
  observacoes  String?
  criadoEm     DateTime  @default(now())
}
